
# Datto SaaS Protection API Configuration
# Credentials are entered through Settings in the dashboard.
# Never share actual API keys.

DATTO_PUBLIC_KEY=
DATTO_SECRET_KEY=
DATTO_BASE_URL=https://api.datto.com

# Live API collection is disabled by default.
# Enable after validating API connectivity.
DATTO_ENABLE_LIVE_COLLECTION=0

# Independent eight-hour scheduler.
# Enable when the client is ready to run it.
DATTO_ENABLE_SCHEDULER=0
